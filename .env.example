# minty-payment-request-web - copy to .env.local. Every value is optional locally: unset means the
# local stack's port (lib/env.ts). Inlined at build time (next.config.ts `env`), so a deployment
# sets them before `next build`.

# Petty Cash (Minty, Flask) - login, /enter, the links back, the /profile/* forwards
PETTY_CASH_URL=http://localhost:8000
# minty-payment-request-api (Django) - every /api/v1 call
PAYMENT_REQUEST_API_URL=http://localhost:8020
# minty-subscription-api (Django) - the sidebar's Subscriptions Overview
SUBSCRIPTION_API_URL=http://localhost:8001

# Optional: 1 (or true) shows the new-app link in /maintenance's footer
# MAINTENANCE_SHOW_NEW_LINK=1
